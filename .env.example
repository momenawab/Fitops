# FitOps — environment variable template
#
# Copy this file to `.env` and fill in real values for your environment.
# `.env` is git-ignored and MUST NEVER be committed.
# This template contains PLACEHOLDERS ONLY — never put a real secret in it.
#
# Variables are grouped by the Story that introduces or consumes them.
# Values are finalized as those Stories are implemented:
#   Story 1.2 — Django backend settings
#   Story 1.4 — PostgreSQL
#   Story 1.5 — Redis + Celery
#   Story 1.6 — Docker Compose

# ---------------------------------------------------------------------------
# Django core (Story 1.2)
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-a-unique-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Security — sessions, cookies, CSRF (Database & Auth Architecture §5, §29)
# Django's built-in session framework; secure cookies required in production.
# ---------------------------------------------------------------------------
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL (Story 1.4)
# ---------------------------------------------------------------------------
POSTGRES_DB=fitops
POSTGRES_USER=fitops
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis / Celery (Story 1.5)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Email — Django email backend + SMTP (Technology Stack, "Email")
# The SMTP provider is deployment configuration and is deliberately unselected
# (docs/MISSING_DECISIONS.md). Application code uses Django's email API only.
# ---------------------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FitOps <no-reply@example.com>

# ---------------------------------------------------------------------------
# Media storage (Technology Stack, "File Storage")
# Hetzner volume / local storage behind a storage abstraction in Phase 1.
# ---------------------------------------------------------------------------
MEDIA_ROOT=./mediafiles
STATIC_ROOT=./staticfiles

# ---------------------------------------------------------------------------
# Frontend (Story 1.3)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
